{
  "name": "tax-doctor-desktop",
  "version": "1.2.0",
  "description": "The Tax Doctor - internal team desktop app (staff only)",
  "main": "main.js",
  "author": "Smack Online Services OPC Pvt Ltd",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.taxdoctor.team",
    "productName": "Tax Doctor Team",
    "copyright": "Built by Smack Online Services OPC Pvt Ltd",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tax Doctor Team",
      "artifactName": "TaxDoctor-Team-Setup.exe",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-ntp.js",
      "shell.html",
      "newtab.html",
      "lock.html",
      "setup.html",
      "assets/**",
      "build/icon.png",
      "build/icon.ico",
      "build/overlay.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "afterPack": "afterPack.js"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2"
  }
}