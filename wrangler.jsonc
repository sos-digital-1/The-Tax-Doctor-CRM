{
  "name": "the-tax-doctor-crm",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tax-doctor-db",
      "database_id": "95bc6b07-5b97-4624-91a3-90f6e418b8b4",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "tax-doctor-files" }],
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": {
    "MAIL_FROM": "The Tax Doctor <no-reply@thetaxdoctor.in>",
    "APP_URL": "https://crm.thetaxdoctor.in"
  }
}
